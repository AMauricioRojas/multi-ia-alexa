# Nexo IA - variables recomendadas
DATABASE_URL=postgresql://usuario:password@host/database
JWT_SECRET=cambia_esto_por_un_secreto_largo
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Correo: en desarrollo usa console para ver códigos en logs
MAIL_MODE=console
# MAIL_MODE=resend
# RESEND_API_KEY=
# EMAIL_FROM=Nexo IA <no-reply@tudominio.com>

# Admin privado
ADMIN_SECRET=cambia_esto_por_una_clave_larga
# Correos que serán considerados admin al iniciar sesión/crear cuenta, separados por coma
ADMIN_EMAILS=

# Keep alive controlado por admin
PUBLIC_URL=https://multi-ia-alexa-backend.onrender.com
ENABLE_SELF_PING=false
SELF_PING_MINUTES=10

# Correo real con Resend para publicación
# En desarrollo puedes dejar MAIL_MODE=console. Para enviar correo real usa MAIL_MODE=resend.
RESEND_API_KEY=
EMAIL_FROM=Nexo IA <no-reply@tudominio.com>
ADMIN_REPORT_EMAIL=equipo@nexoia.com

# Cupos de consultas para beta. No son precios ni cuotas comerciales.
BASIC_REQUEST_LIMIT=20
PRO_REQUEST_LIMIT=200
GLOBAL_REQUEST_LIMIT=1000
# Tamaño máximo del contexto enviado y límite de salida por llamada.
AI_MAX_INPUT_BYTES=16000
AI_MAX_OUTPUT_TOKENS=512
AI_TIMEOUT_MS=20000

# Account Linking oficial. El secreto debe ser aleatorio, mínimo 32 caracteres.
ALEXA_SKILL_ID=amzn1.ask.skill.af89bcff-c415-4a3d-9b3d-7494967ba0b4
ALEXA_OAUTH_CLIENT_ID=nexo-alexa
ALEXA_OAUTH_CLIENT_SECRET=
ALEXA_REDIRECT_URIS=https://layla.amazon.com/api/skill/link/M222WJ0XFAY00T,https://alexa.amazon.co.jp/api/skill/link/M222WJ0XFAY00T,https://pitangui.amazon.com/api/skill/link/M222WJ0XFAY00T
# Desactivado en la beta pública; sólo para migración controlada de usuarios antiguos.
ALEXA_LEGACY_PAIRING=false
